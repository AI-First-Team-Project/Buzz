# Android emulator. Copy this file to .env before building if you want an
# explicit value; native builds also default to this address when unset.
VITE_API_BASE_URL=http://10.0.2.2:8000

# Physical Android device: replace the value above with the development PC's
# LAN IPv4 address, for example http://192.168.0.10:8000.
# Browser-only Vite development on the PC can use http://localhost:8000.
